with "runtime/build_libgnat.gpr";
with "runtime/build_libgnarl.gpr";
project ACATS_C8 is
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use "runtime";
   for Source_Dirs use ("source", "../support", "../ACATS/support", "../ACATS/c8");
   for Object_Dir use ".objs";
   for Exec_Dir use ".objs";
   for Main use ("main.adb");
   package Builder is
      for Executable ("main.adb") use "app_main.o";
   end Builder;
   package Binder is
      for Switches ("Ada") use ("-D16k", "-Q3", "-Mapp_main");
   end Binder;
   package Compiler is
      for Switches ("Ada") use ("-fstack-check", "-g", "-O2");
      --  C854002 deliberately calls unelaborated renamings and catches PE.
      --  The static elaboration model rejects its intentional dependency cycle.
      for Switches ("c854002.a") use
        ("-fstack-check", "-g", "-O2", "-gnatE");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;
   package Naming is
      for Specification ("version") use "version.a";
      for Specification ("tctouch") use "tctouch.ada" at 1;
      for Implementation ("tctouch") use "tctouch.ada" at 2;
