with "runtime/build_libgnat.gpr";
with "runtime/build_libgnarl.gpr";
project ACATS_C3 is
   for Target use "xtensa-esp32-elf";
   for Runtime ("Ada") use "runtime";
   for Source_Dirs use ("source", "../support", "../ACATS/support", "../ACATS/c3");
   for Object_Dir use ".objs";
   for Exec_Dir use ".objs";
   for Main use ("main.adb");
   package Builder is
      for Executable ("main.adb") use "app_main.o";
   end Builder;
   package Binder is
      for Switches ("Ada") use ("-D4k", "-Q3", "-Mapp_main");
   end Binder;
   package Compiler is
      for Switches ("Ada") use ("-g", "-O2");
   end Compiler;
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-r", "-nostdlib");
   end Linker;
